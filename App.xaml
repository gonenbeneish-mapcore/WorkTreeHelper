<Application x:Class="WorktreeHelper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="System">
    <!-- ThemeMode="System": Fluent theme that follows the Windows light/dark setting
         and switches live when the user changes it. -->
    <Application.Resources>
        <!-- GitHub's mark, for the pull request button and its checkbox in Options: the page it
             opens is on GitHub. Drawn from the mark-github path in Octicons, GitHub's own
             MIT-licensed icon set, rather than a downloaded favicon, so it is sharp at any
             scaling. In the text colour, as GitHub's own favicon is dark on light and light on
             dark. -->
        <Viewbox x:Key="GitHubMark" x:Shared="False" Width="16" Height="16">
            <Path Fill="{DynamicResource TextFillColorPrimaryBrush}"
                  Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </Viewbox>
        <!-- A program's icon on its button, at the size the glyphs beside it are drawn, and beside
             its checkbox in Options. Here rather than in either window, which both show them. -->
        <Style x:Key="AppIcon" TargetType="Image">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        </Style>
    </Application.Resources>
</Application>
