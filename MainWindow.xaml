<Window x:Class="WorktreeHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:WorktreeHelper"
        Title="{Binding WindowTitle}"
        Icon="app.ico"
        Width="440" Height="28" MinWidth="440" MinHeight="28"
        ResizeMode="CanMinimize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" DragLeave="Window_DragLeave">

    <!-- The top strip belongs to the app, so the folder, refresh and pin controls can live
         in it rather than costing a row of their own. The caption buttons come with us:
         UseAeroCaptionButtons off means the close button below is ours to draw.

         The window background is set explicitly because of this. The Fluent theme leaves it
         transparent for a Mica backdrop, and a window with no DWM frame and no background of
         its own is a see-through window.

         CanMinimize rather than NoResize, which is all the sizing the user gets either way:
         NoResize leaves the window without WS_MINIMIZEBOX, and the shell will not minimize a
         window that says it cannot be minimized - so clicking its taskbar button only ever
         raised it. The minimize box is never drawn: the caption is the app's own. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28" ResizeBorderThickness="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Shown from the tray icon. A WPF menu rather than a Win32 one so it
             follows the Fluent light/dark theme like the rest of the app. The worktrees
             themselves are inserted below the first item on each open, by PopulateTrayMenu.

             No taskbar switch of its own: where the app lives is in Options, one item down,
             and the same choice in two places was one more thing on a short menu. -->
        <ContextMenu x:Key="TrayMenu">
            <MenuItem Header="Show Worktree Helper" Click="TrayShow_Click" FontWeight="SemiBold"
                      Tag="tray.show"/>
            <MenuItem Header="Refresh" Click="Refresh_Click"/>
            <MenuItem Header="Options…" Click="Options_Click"/>
            <Separator/>
            <MenuItem Header="Exit" Click="TrayExit_Click"/>
        </ContextMenu>
        <!-- One menu for every row: a ContextMenu inherits the DataContext of the row it
             opens on, so each item acts on the worktree that was right-clicked. -->
        <ContextMenu x:Key="RowMenu" Opened="RowMenu_Opened">
            <MenuItem Header="Open in VS Code" Click="MenuOpenCode_Click" FontWeight="SemiBold"/>
            <MenuItem Header="Open terminal here" Click="MenuOpenTerminal_Click"/>
            <MenuItem Header="Show in File Explorer" Click="MenuOpenExplorer_Click"/>
            <MenuItem Header="Open in Git Extensions" Click="MenuOpenGitExtensions_Click"
                      Tag="row.gitextensions"/>
            <MenuItem Header="Open in Visual Studio" Click="MenuOpenVisualStudio_Click"
                      Visibility="{Binding HasVisualStudio, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
            <MenuItem Header="Open pull request" Click="MenuOpenPullRequest_Click"
                      Visibility="{Binding HasPullRequest, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
            <Separator/>
            <MenuItem Header="Copy path" Click="MenuCopyPath_Click"/>
            <MenuItem Header="Copy branch name" Click="MenuCopyBranch_Click"/>
        </ContextMenu>
        <!-- The row reacts to the pointer, which is the only sign that it can be
             double-clicked and right-clicked. -->
        <Style x:Key="RowCard" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!-- Square icon-only action button; the tooltip carries the label.

             Templated rather than derived from the Fluent button style: three outlined boxes
             per row were the heaviest thing in the window after the title bar, and the theme
             drives its own background through VisualStateManager storyboards, which run at
             animation precedence and outrank any Setter. Borderless until the pointer is on
             it, using the subtle fills Windows itself uses for icon buttons. -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="4"
                                    SnapsToDevicePixels="True"/>
                            <!-- The program already has this worktree open: an accent ring round
                                 the button, which a click brings back rather than opening again.
                                 A ring rather than a tint of the icon, which is in colour, or a
                                 mark under it, which at this size went unnoticed. -->
                            <Border x:Name="OpenRing" Visibility="Collapsed" CornerRadius="4" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="local:OpenMark.IsOpen" Value="True">
                                <Setter TargetName="OpenRing" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
<!-- An update waiting to be installed. The one control up here that appears on its own
             and has to be noticed, so it is the only filled thing in the caption: an accent
             block with the version written out, first in the row. Tinting the glyph and
             leaving it among five other glyphs was not enough to be seen. -->
        <Style x:Key="UpdateButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The two buttons inside the update notice. Drawn in white rather than in theme
             brushes: they sit on the accent fill, where the theme’s own control colours
             would be a grey box on a coloured card. -->
        <Style x:Key="ToastButton" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" CornerRadius="4" Background="#26FFFFFF"
                                BorderBrush="#59FFFFFF" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToastCloseButton" TargetType="Button" BasedOn="{StaticResource ToastButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <!-- The window's own close button, since the system one went with the caption.
             Full caption height and red on hover, the way every other window behaves. -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#B0251A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
<!-- Keep-on-top toggle, templated like the buttons beside it. Derived from the Fluent
             toggle style it kept that theme's filled box and border, which stood out as a chip
             among borderless glyphs; and the theme animates its own Background through
             VisualStateManager, at animation precedence, so no Setter could take it away. -->
        <Style x:Key="PinButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Keep this window on top of other windows"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <!-- Held down: filled, so it reads as pressed rather than merely tinted. -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                <Setter Property="ToolTip" Value="Staying on top — click to unpin"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
<!-- Pull request button, on rows whose branch has one open. Lettered for the same
             reason as the Visual Studio one: the icon font has nothing that reads as a pull
             request, and two initials cannot be mistaken for anything else. -->
        <Style x:Key="PrButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- The terminal button. Lettering for the same reason as the buttons below it: the
             icon font's only terminal glyph is a window with "c:\" crammed inside it, which
             at this size is a grey smudge, while a prompt reads as a command line at any
             size and sits naturally beside the {} next to it. -->
        <Style x:Key="TerminalButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
            <Setter Property="FontFamily" Value="Cascadia Mono, Cascadia Code, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="ToolTip" Value="Open a terminal in this worktree"/>
        </Style>
        <!-- Git Extensions, where it is installed. Lettered like the PR and VS buttons: the
             icon font has nothing for it, and its own icon would be the one coloured thing
             among monochrome glyphs. -->
        <Style x:Key="GitExtensionsButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="ToolTip" Value="Open this worktree in Git Extensions"/>
        </Style>
        <!-- Visual Studio buttons. Lettering rather than a glyph: the icon font has nothing
             that reads as Visual Studio, and two initials are unmistakable.

             Only the look is shared below. Each button stands for one mode and says what
             pressing it will do in that mode, because once both are on the row the only
             question left is which of the two is the one already running. The modes no
             longer inherit each other’s triggers: the folder button derived from the
             solution one, so opening the solution accent-marked both buttons and left the
             folder one offering to focus a window it has nothing to do with. -->
        <Style x:Key="VsButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- What each way into Visual Studio looks like: the lettering for the solution, and
             a folder with VS written in its body for the other one. Defined here rather than
             in the row template because the menu that offers the choice draws the same two
             marks beside its items, and one definition keeps them the same.

             x:Shared="False" hands out a new visual per lookup — an element belongs to one
             parent, and these are asked for once per row and again every time the menu
             opens. Neither sets a Foreground, so both take the colour of whatever holds
             them, which is what lets the open mode tint its button. -->
        <TextBlock x:Key="VsSolutionIcon" x:Shared="False" Text="VS"
                   FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Grid x:Key="VsFolderIcon" x:Shared="False">
            <!-- 16 rather than the 14 its neighbours use: the smallest that leaves the
                 lettering legible while still reading as the same size as the Explorer
                 folder beside it. -->
            <TextBlock Text="&#xE8B7;" FontSize="16" HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <!-- In the folder’s body, which sits below the glyph’s centre because of the
                 tab along its top. -->
            <TextBlock Text="VS" FontSize="6" FontWeight="SemiBold" FontFamily="Segoe UI"
                       Margin="0,2.5,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <!-- The folder on Visual Studio's icon that makes it the folder mode, set on a patch of
             the card's colour so it reads apart from the icon under it. -->
        <Border x:Key="FolderBadge" x:Shared="False" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,-3,-2" Padding="1,0,1,0" CornerRadius="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Border>
        <!-- Shown while neither mode is open, where there is still a choice to make. -->
        <Style x:Key="VsChooserButton" TargetType="Button" BasedOn="{StaticResource VsButton}">
            <Setter Property="ToolTip" Value="Open this worktree in Visual Studio — the generated solution, or the folder"/>
        </Style>
        <!-- The solution mode, once either mode is open. -->
        <Style x:Key="VsSolutionButton" TargetType="Button" BasedOn="{StaticResource VsButton}">
            <Setter Property="ToolTip" Value="Generate the solution and open it in a second Visual Studio, alongside the folder one"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSolutionOpen}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <Setter Property="ToolTip" Value="The solution is open in Visual Studio — click to focus that window"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The folder mode. Its content is a folder with VS written inside it, so it reads
             as "Visual Studio, the folder one" in the width of one button. -->
        <Style x:Key="VsFolderButton" TargetType="Button" BasedOn="{StaticResource VsButton}">
            <Setter Property="ToolTip" Value="Open this worktree as a folder in a second Visual Studio, alongside the solution one"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFolderOpen}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <Setter Property="ToolTip" Value="This worktree is open as a folder in Visual Studio — click to focus that window"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- VS Code button: marked when that worktree already has a window, where clicking
             focuses it rather than launching. The glyph itself takes the accent colour: the
             buttons around it are borderless, and anything drawn behind or under it read as
             a stray mark among them. -->
        <Style x:Key="CodeButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="ToolTip" Value="Open this worktree in Visual Studio Code"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpenInVsCode}" Value="True">
                    <Setter Property="ToolTip" Value="Already open in VS Code — click to focus that window"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Caption: the repository path, then the controls that act on it.

             Dragging is done here rather than left to WindowChrome. Its caption hit-testing
             was measured returning HTCLIENT everywhere in this configuration, whatever the
             resize mode, so the window could not be moved at all. -->
        <Grid Grid.Row="0" Height="28" Background="Transparent"
              MouseLeftButtonDown="Caption_MouseDown"
              MouseRightButtonUp="Caption_RightClick"
              shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- The icon is where you look to ask what this is and which version of it, and
                 where Windows has always kept a window’s own menu. Clicking it opens ours,
                 which is the only way to reach it once there is no tray icon to right-click. -->
            <Image x:Name="TitleBarIcon" Grid.Column="0" Width="16" Height="16" Margin="8,0,8,0"
                   VerticalAlignment="Center" Cursor="Hand"
                   Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                   MouseLeftButtonUp="TitleBarIcon_Click"
                   ToolTip="{Binding AppTooltip}"
                   shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

            <!-- The app and its version, briefly displaced by whatever just happened. Not the
                 repository's path: that is in Options, where it can be changed, and a long one
                 here left almost nowhere to take hold of the window. A press on this text is a
                 press on the caption, so it moves the window like the rest of the bar.

                 Capped, so a long status message does not stretch the window to fit it. -->
            <TextBlock Grid.Column="1" Text="{Binding CaptionText}" VerticalAlignment="Center"
                       HorizontalAlignment="Left" MaxWidth="360"
                       FontSize="12" TextTrimming="CharacterEllipsis" Padding="0,6"
                       shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- First, ahead of the controls that are always here: an update is the
                     one thing in this caption that was not there a moment ago, and the eye
                     lands on the start of the group. Only there when a newer release
                     exists, and its tooltip carries the release notes. -->
                <Button Style="{StaticResource UpdateButton}" Click="Update_Click"
                        AutomationProperties.Name="Install the update"
                        IsEnabled="{Binding IsUpdating, Converter={x:Static local:BoolToVisibilityConverter.Not}}"
                        Visibility="{Binding HasUpdate, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding UpdateLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- A string tooltip is laid out on one line however long it is, and
                         release notes are long. -->
                    <Button.ToolTip>
                        <TextBlock Text="{Binding UpdateTooltip}" TextWrapping="Wrap" MaxWidth="380"/>
                    </Button.ToolTip>
                </Button>
                <Button Style="{StaticResource RowButton}" Click="Refresh_Click"
                        Content="&#xE72C;" IsEnabled="{Binding HasRepo}" ToolTip="Refresh"
                        AutomationProperties.Name="Refresh"/>
                <Button Style="{StaticResource RowButton}" Click="Options_Click"
                        Content="&#xE713;" ToolTip="Options"
                        AutomationProperties.Name="Options"/>
                <ToggleButton Style="{StaticResource PinButton}" IsChecked="{Binding IsPinned}"
                              Content="&#xE718;" AutomationProperties.Name="Keep window on top"/>
                <Button Style="{StaticResource CloseButton}" Click="Close_Click"
                        Content="&#xE8BB;" ToolTip="{Binding CloseHint}"
                        AutomationProperties.Name="Close"/>
            </StackPanel>
        </Grid>

        <!-- Worktree list. No column headers: with one line per row, "WORKTREE" over the
             names and "BRANCH" over the branches only said what the rows already show. -->
        <!-- The folds under the title bar, one above the other: the first-run question, and
             what is new in this version. In practice they never meet - someone new is asked
             the question and has nothing to be told - but stacked, they could. -->
        <StackPanel Grid.Row="1">
        <!-- Asked once, on the first run, and never again. The window is already on screen at
             that point, so this costs no dialog. -->
        <Border x:Name="TaskbarQuestionFold" Margin="6,4,6,0" Padding="8,6" CornerRadius="6"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{Binding ShowTaskbarQuestion, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                           Text="Live in the taskbar, or in the system tray?"/>
                <Button Grid.Column="1" Content="Taskbar" Margin="8,0,0,0" Padding="10,3" FontSize="12"
                        Click="ChooseTaskbar_Click"
                        ToolTip="A taskbar button and an Alt+Tab entry. Closing the window exits the app."/>
                <Button Grid.Column="2" Content="System tray" Margin="6,0,0,0" Padding="10,3" FontSize="12"
                        Click="ChooseTrayOnly_Click"
                        ToolTip="An icon in the notification area. Closing the window only puts it away."/>
            </Grid>
        </Border>

        <!-- What is new, on the first run of a version the user has not been told about. It
             folds away when closed and does not come back until the next version. The text is
             the changelog's, so it is the same thing the release page says.

             The notes are capped in width: the window sizes itself to its contents, and wrapped
             text measured with room to spare would rather be one long line, which would drag
             the window as wide as the screen allows. Capped in height too, with a scroll bar
             for a long release, since a window that is all release notes has lost its point. -->
        <Border x:Name="WhatsNewFold" Margin="6,4,6,0" Padding="12,9" CornerRadius="6"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1"
                Visibility="{Binding ShowWhatsNew, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{Binding WhatsNewHeading}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Close" Padding="12,3" FontSize="12"
                        Click="DismissWhatsNew_Click" AutomationProperties.Name="Close what's new"/>

                <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" MaxHeight="240"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding WhatsNewNotes}" MaxWidth="480" HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ReleaseNotes}">
                                <StackPanel Margin="0,0,0,4">
                                    <!-- The version, only when there is more than one to tell apart. -->
                                    <TextBlock Text="{Binding Version}" FontSize="11" FontWeight="SemiBold"
                                               Margin="0,4,0,2" Style="{StaticResource MutedText}"
                                               Visibility="{Binding WhatsNewHasSeveral, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                                    <ItemsControl ItemsSource="{Binding Points}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ChangePoint}">
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="1">
                                                                    <Setter Property="Margin" Value="16,2,0,0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#x2022;" FontSize="12" Style="{StaticResource MutedText}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12"
                                                               TextWrapping="Wrap"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        </StackPanel>

        <!-- Held back until the first refresh has all of it, so it comes in with one resize. -->
        <ScrollViewer x:Name="ListScroller" Grid.Row="2" Margin="6,2,6,4" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsListReady, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <ItemsControl ItemsSource="{Binding Worktrees}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:Worktree}">
                        <Border Style="{StaticResource RowCard}"
                                ContextMenu="{StaticResource RowMenu}"
                                MouseLeftButtonDown="Row_MouseDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="WtName"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="WtActions"/>
                                </Grid.ColumnDefinitions>

                                <!-- Name only. A second line for the path repeated the same parent folder in
                                     every row under names that already carry the part that differs;
                                     the full path is a hover away, and the row is half the height. -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="0,0,8,0" ToolTip="{Binding Path}">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" MaxWidth="320"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border Margin="5,0,0,0" Padding="5,0" CornerRadius="4" VerticalAlignment="Center"
                                            BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                            Visibility="{Binding HasBadges, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                        <TextBlock Text="{Binding Badges}" FontSize="9" Style="{StaticResource MutedText}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Branch -->
                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="WtBranchIcon"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="WtStatus"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE8AB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,5,0" Style="{StaticResource MutedText}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayBranch}" FontFamily="Cascadia Code, Cascadia Mono, Consolas" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayBranch}"/>

                                    <!-- Uncommitted work and drift from upstream. Nothing is drawn for a
                                         worktree that is clean and level, so a quiet row means there is
                                         nothing waiting in it. -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                HorizontalAlignment="Left" Margin="8,0,0,0"
                                                Visibility="{Binding HasStatus, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                        <!-- The same tone as the count beside it. Caution amber cried wolf over
                                             ordinary uncommitted work, and the theme's "attention" brush is the
                                             accent colour, which already means "open in VS Code". -->
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,5,0"
                                                 Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                                 Visibility="{Binding IsDirty, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                                        <TextBlock Text="{Binding StatusSummary}" FontSize="10" VerticalAlignment="Center"
                                                   FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                                                   Style="{StaticResource MutedText}"
                                                   ToolTip="{Binding StatusTooltip}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Actions. A StackPanel, which rounds each button's position in
                                     turn, so identical buttons land on identical pixels in every row.
                                     A Grid was tried for the columns layout and drifted: at 125% a
                                     button is 32.5 physical pixels, and a stretched Grid spreads the
                                     half-pixels differently by how many buttons a row has, which put
                                     the widest row up to four pixels out.

                                     Columns come instead from holding a button's place. A button a row
                                     lacks is hidden rather than collapsed when some other row has one
                                     and the buttons are kept in columns, and because every button is
                                     the same width, the next one lands where it would in a row that
                                     has it. A column no row uses is collapsed everywhere and costs
                                     nothing.

                                     Each kind can be turned off in Options, which collapses it in
                                     every row alike, so the columns stay lined up. The buttons that
                                     come and go by row sit in a panel that the option collapses,
                                     because their own Visibility is already the row's to decide. -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <!-- Each button shows the icon of the program it opens, as Windows
                                         does, and keeps its own mark only where no icon could be had.
                                         A colour icon cannot be tinted to say its window is already open,
                                         so the button's own template marks it, from OpenMark. -->
                                    <Button Style="{StaticResource CodeButton}" Click="OpenCode_Click" Tag="{Binding Path}"
                                            local:OpenMark.IsOpen="{Binding IsOpenInVsCode}"
                                            AutomationProperties.Name="Open in VS Code"
                                            Visibility="{Binding VsCodeTool.Shown, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                        <Grid>
                                            <Image Style="{StaticResource AppIcon}"
                                                   Source="{Binding VsCodeTool.Icon, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <TextBlock Text="&#xE943;" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding VsCodeTool.Icon, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:NullToVisibilityConverter.WhenNull}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOpenInVsCode}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource TerminalButton}" Click="OpenTerminal_Click" Tag="{Binding Path}"
                                            AutomationProperties.Name="Open a terminal in this worktree"
                                            Visibility="{Binding ShowTerminalButton, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                        <Grid>
                                            <Image Style="{StaticResource AppIcon}"
                                                   Source="{Binding TerminalIcon, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <TextBlock Text="&gt;_" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding TerminalIcon, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:NullToVisibilityConverter.WhenNull}}"/>
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource RowButton}" Click="OpenExplorer_Click" Tag="{Binding Path}"
                                            ToolTip="Show this folder in File Explorer"
                                            AutomationProperties.Name="Show this folder in File Explorer"
                                            Visibility="{Binding ShowExplorerButton, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                        <Grid>
                                            <Image Style="{StaticResource AppIcon}"
                                                   Source="{Binding ExplorerIcon, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <TextBlock Text="&#xE8B7;" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding ExplorerIcon, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:NullToVisibilityConverter.WhenNull}}"/>
                                        </Grid>
                                    </Button>
                                    <!-- Only where Git Extensions is installed. With the buttons every
                                         row has, rather than after the ones that come and go, so it
                                         lines up down the list however the rows below it differ. -->
                                    <Button Style="{StaticResource GitExtensionsButton}" Click="OpenGitExtensions_Click" Tag="{Binding Path}"
                                            local:OpenMark.IsOpen="{Binding IsOpenInGitExtensions}"
                                            AutomationProperties.Name="Open in Git Extensions"
                                            Visibility="{Binding GitExtensionsTool.Shown, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                        <Grid>
                                            <Image Style="{StaticResource AppIcon}"
                                                   Source="{Binding GitExtensionsTool.Icon, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <TextBlock Text="GE" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding GitExtensionsTool.Icon, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:NullToVisibilityConverter.WhenNull}}"/>
                                        </Grid>
                                    </Button>
                                    <!-- Only for worktrees that carry the script, so nothing shows here
                                         for a repository that does not use one.

                                         Until something is open there is a choice to make, so one button
                                         asks. Afterwards it gives way to one button per mode: the open one
                                         focuses its window, and the other - where a second instance is
                                         allowed - starts it without asking. The chooser and the solution
                                         button share one slot because they are never up together, so it is
                                         the chooser that holds the place when neither is.

                                         All three carry Visual Studio's icon; the folder one has a folder
                                         on it, which is what tells the two modes apart. -->
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding VisualStudioTool.Shown, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                        <Button Style="{StaticResource VsChooserButton}" Click="OpenVisualStudio_Click" Tag="{Binding Path}"
                                                AutomationProperties.Name="Open in Visual Studio">
                                            <Button.Visibility>
                                                <MultiBinding Converter="{x:Static local:SlotVisibility.Instance}">
                                                    <Binding Path="ShowVisualStudioChooser"/>
                                                    <Binding Path="HoldVsColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    <Binding Path="ShowSolutionButton"/>
                                                </MultiBinding>
                                            </Button.Visibility>
                                            <Grid>
                                                <Image Style="{StaticResource AppIcon}"
                                                       Source="{Binding VisualStudioTool.Icon, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <TextBlock Text="VS" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding VisualStudioTool.Icon, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:NullToVisibilityConverter.WhenNull}}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource VsSolutionButton}" Click="SolutionVisualStudio_Click" Tag="{Binding Path}"
                                                local:OpenMark.IsOpen="{Binding IsSolutionOpen}"
                                                AutomationProperties.Name="The Visual Studio solution"
                                                Visibility="{Binding ShowSolutionButton, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                            <Grid>
                                                <Image Style="{StaticResource AppIcon}"
                                                       Source="{Binding VisualStudioTool.Icon, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <TextBlock Text="VS" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding VisualStudioTool.Icon, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:NullToVisibilityConverter.WhenNull}}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource VsFolderButton}" Click="FolderVisualStudio_Click" Tag="{Binding Path}"
                                                local:OpenMark.IsOpen="{Binding IsFolderOpen}"
                                                AutomationProperties.Name="This worktree as a folder in Visual Studio">
                                            <Button.Visibility>
                                                <MultiBinding Converter="{x:Static local:SlotVisibility.Instance}">
                                                    <Binding Path="ShowFolderButton"/>
                                                    <Binding Path="HoldVsFolderColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </Button.Visibility>
                                            <Grid>
                                                <Grid Visibility="{Binding VisualStudioTool.Icon, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:NullToVisibilityConverter.WhenSet}}">
                                                    <Image Style="{StaticResource AppIcon}"
                                                           Source="{Binding VisualStudioTool.Icon, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <ContentControl Content="{StaticResource FolderBadge}"/>
                                                </Grid>
                                                <ContentControl Content="{StaticResource VsFolderIcon}"
                                                                Visibility="{Binding VisualStudioTool.Icon, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:NullToVisibilityConverter.WhenNull}}"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                    <!-- Only where the branch has an open pull request. -->
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding ShowPullRequestButton, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                        <Button Style="{StaticResource PrButton}" Click="OpenPullRequest_Click"
                                                Tag="{Binding PullRequest}" Content="{StaticResource GitHubMark}"
                                                AutomationProperties.Name="Open the pull request">
                                            <Button.Visibility>
                                                <MultiBinding Converter="{x:Static local:SlotVisibility.Instance}">
                                                    <Binding Path="HasPullRequest"/>
                                                    <Binding Path="HoldPrColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </Button.Visibility>
                                            <Button.ToolTip>
                                                <TextBlock Text="{Binding PullRequestTooltip}" TextWrapping="Wrap" MaxWidth="380"/>
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Failures. The caption carries the status line and truncates it, which loses the
             part of a git error that says what went wrong; this appears only when there is
             something to read, so it costs no space the rest of the time. -->
        <Border Grid.Row="3" Margin="6,0,6,6" Padding="8,6" CornerRadius="6"
                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                BorderBrush="{DynamicResource SystemFillColorCriticalBrush}" BorderThickness="1"
                Visibility="{Binding HasError, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE783;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                <!-- Read-only text box rather than a TextBlock so the message can be selected
                     and copied, which is the first thing anyone does with an error. -->
                <TextBox Grid.Column="1" Text="{Binding Error, Mode=OneWay}" IsReadOnly="True"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         TextWrapping="Wrap" FontSize="12" IsTabStop="False"/>
            </Grid>
        </Border>

        <!-- Empty state -->
        <TextBlock Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxWidth="420"
                   Text="Choose a repository in Options (the gear above), or drop a folder here, to list its worktrees."
                   Visibility="{Binding ShowEmptyHint, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>

        <!-- What announces an update rather than waiting to be spotted: it arrives under
             the caption, beside the button it is about, and takes itself away after a few
             seconds.

             In a Canvas because a Canvas asks for no space of its own, however large the
             thing inside it. The window sizes itself to its contents, so a notice that took
             part in that measurement would push the window wider for as long as it was up
             and let it snap back when it went: measured at 1149px against 715px with the
             notice widened past the rows behind it. Nothing constrains it to the window now,
             so its MaxWidth stays under the window’s own MinWidth of 440.

             The pointer resting on it stops the countdown — nothing should disappear
             from under someone who is reading it. -->
        <Canvas Grid.Row="1" Grid.RowSpan="3" Panel.ZIndex="1">
        <Border x:Name="UpdateToast" Canvas.Top="6" Canvas.Right="6"
                Padding="12,9" CornerRadius="8" MaxWidth="420"
                Background="{DynamicResource AccentFillColorDefaultBrush}"
                MouseEnter="UpdateToast_MouseEnter" MouseLeave="UpdateToast_MouseLeave"
                Visibility="{Binding ShowUpdateToast, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding UpdateHeadline}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    <TextBlock Text="{Binding UpdateDetail}" FontSize="11" Opacity="0.85" MaxWidth="260"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                </StackPanel>
                <Button Style="{StaticResource ToastButton}" Content="Install" Click="Update_Click"
                        IsEnabled="{Binding IsUpdating, Converter={x:Static local:BoolToVisibilityConverter.Not}}"
                        AutomationProperties.Name="Install the update"/>
                <Button Style="{StaticResource ToastCloseButton}" Content="&#xE8BB;" Click="DismissUpdateToast_Click"
                        ToolTip="Dismiss. The button in the caption stays."
                        AutomationProperties.Name="Dismiss"/>
            </StackPanel>
        </Border>
        </Canvas>

        <!-- Drop target. Last child so it covers the rest, and hit-testing nothing so the
             drag still reaches the window underneath it. -->
        <Grid Grid.Row="0" Grid.RowSpan="4" IsHitTestVisible="False"
              Visibility="{Binding IsDragOver, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <Border Opacity="0.12" Background="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Border BorderThickness="2" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Border Padding="10,5" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                <TextBlock Text="Drop a folder to load its worktrees" FontSize="12"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
