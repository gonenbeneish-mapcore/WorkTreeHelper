<!-- The app's options. Every control is bound straight to the main window's own property for
     it, so a change takes effect as it is made and the list behind the window moves with it;
     there is no OK, and so nothing to lose by closing it. -->
<Window x:Class="WorktreeHelper.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WorktreeHelper"
        Title="Options"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- What each choice does, under it rather than in a tooltip: an option nobody can
             work out without hovering is an option nobody changes. -->
        <Style x:Key="Explains" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="28,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,16,20,18">

        <!-- The repository, which is chosen here and nowhere else in the window. Browse is
             the usual way; typing is for the one thing a folder picker cannot do, since it
             resolves symbolic links and junctions and can only ever hand back the target.
             Open, rather than Enter: Escape is the one key the app answers to. -->
        <TextBlock Style="{StaticResource Heading}" Text="Repository"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" Text="{Binding RepoPath, Mode=OneWay}" FontSize="12"
                     VerticalContentAlignment="Center"
                     AutomationProperties.Name="Repository path"/>
            <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Padding="12,4"
                    Click="Browse_Click" AutomationProperties.Name="Browse for a repository"/>
            <Button x:Name="OpenButton" Grid.Column="2" Content="Open" Margin="6,0,0,0" Padding="14,4"
                    Click="Open_Click" AutomationProperties.Name="Open this repository"/>
        </Grid>
        <TextBlock Style="{StaticResource Explains}" Margin="0,6,0,4"
                   Text="Any folder inside a git repository. Browse for one, or type its path and press Open: typing is the way to open one through a symbolic link, since Browse always follows a link to where it points."/>
        <!-- What went wrong with the last path, if anything did. It is the main window's own
             message, so it reads the same here as in the bar under the list. -->
        <TextBlock Text="{Binding Error}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   Visibility="{Binding HasError, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>


        <!-- Radio buttons in one panel are one group unless told otherwise, and the two
             questions here are separate questions, so each pair is named.

             Each button only shows the setting, and says what it wants through Checked. Bound
             both ways, a pair on one setting writes back to it while the group is unchecking
             the other button, which then writes the opposite: once an earlier Options window
             was still listening as well, that went round until the stack ran out. -->
        <TextBlock Style="{StaticResource Heading}" Text="Where it lives" Margin="0,10,0,6"/>
        <RadioButton GroupName="Home" Content="System tray" Checked="Tray_Checked"
                     IsChecked="{Binding LivesInTaskbar, Mode=OneWay, Converter={x:Static local:BoolToVisibilityConverter.Not}}"/>
        <TextBlock Style="{StaticResource Explains}"
                   Text="An icon in the notification area. Closing the window puts it away; Exit on the icon's menu quits."/>
        <RadioButton GroupName="Home" Content="Taskbar" Checked="Taskbar_Checked"
                     IsChecked="{Binding LivesInTaskbar, Mode=OneWay}"/>
        <TextBlock Style="{StaticResource Explains}"
                   Text="A taskbar button and an Alt+Tab entry, and no tray icon. Closing the window exits the app."/>

        <TextBlock Style="{StaticResource Heading}" Text="Visual Studio" Margin="0,10,0,6"/>
        <CheckBox Content="Allow a second Visual Studio on the same worktree"
                  IsChecked="{Binding AllowSecondVisualStudio}"/>
        <TextBlock Style="{StaticResource Explains}"
                   Text="Once the solution or the folder is open, the row offers the other one too. Off, it only offers to bring back the one that is open."/>

        <TextBlock Style="{StaticResource Heading}" Text="Buttons" Margin="0,10,0,6"/>
        <RadioButton GroupName="Layout" Content="Packed" Checked="Packed_Checked"
                     IsChecked="{Binding AlignColumns, Mode=OneWay, Converter={x:Static local:BoolToVisibilityConverter.Not}}"/>
        <TextBlock Style="{StaticResource Explains}"
                   Text="Each row's buttons sit together, which keeps the window as small as it can be."/>
        <RadioButton GroupName="Layout" Content="In columns" Checked="Columns_Checked"
                     IsChecked="{Binding AlignColumns, Mode=OneWay}"/>
        <TextBlock Style="{StaticResource Explains}"
                   Text="Each kind of button keeps its own column down the list, with a gap in a row that has none."/>

        <Button Content="Close" HorizontalAlignment="Right" Margin="0,8,0,0" Padding="18,4"
                IsCancel="True" Click="Close_Click"/>
    </StackPanel>
</Window>
