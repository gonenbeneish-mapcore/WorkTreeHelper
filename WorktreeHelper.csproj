<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>WorktreeHelper</AssemblyName>
    <RootNamespace>WorktreeHelper</RootNamespace>
    <!-- ThemeMode (Fluent theme) is still flagged experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Shown in Explorer's Properties/Details and by SmartScreen on an unsigned exe. -->
    <Version>1.6.0</Version>
    <Product>Worktree Helper</Product>
    <AssemblyTitle>Worktree Helper</AssemblyTitle>
    <Description>Lists the worktrees of a git repository and opens them in VS Code, a terminal or Explorer.</Description>
    <Company>Mapcore</Company>
    <Copyright>Copyright © Mapcore</Copyright>
    <!-- Allows restore/build of the Windows TFM from a non-Windows host (CI) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WorktreeHelper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also a Resource, not just the exe's icon: the caption is drawn by the app now,
         so the window has to be able to load it. -->
    <Resource Include="app.ico" />
    <!-- The pale-disc colourway, for a dark theme. Only app.ico can be the exe's own icon. -->
    <Resource Include="app-dark.ico" />
    <!-- Read on the first run of a new version, to say what is new in it. -->
    <EmbeddedResource Include="CHANGELOG.md" LogicalName="CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests live in their own project; without this the app would compile them too,
         because the SDK's source glob reaches every folder below this one. -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>
